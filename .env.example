# --- Groq (reasoning) -- free key: https://console.groq.com/keys ---------------------------
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=llama-3.3-70b-versatile
# Tried in order if the primary model errors or returns nothing:
GROQ_FALLBACK_MODELS=openai/gpt-oss-120b,qwen/qwen3-32b

# --- Hindsight (memory) -- Cloud: https://ui.hindsight.vectorize.io (promo MEMHACK99) --------
HINDSIGHT_API_KEY=hs_xxxxxxxxxxxxxxxxxxxxxxxx
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
# Running Hindsight locally via Docker instead? Use http://localhost:8888 and leave the key blank.
HINDSIGHT_BANK_ID=prod-cluster-3

# --- Business-impact assumption (an assumption, not a measurement; set your own) ---------
OUTAGE_COST_PER_MINUTE=5000

# --- Set to 1 to run everything on the local replay backend (no keys, no network) --------
ONCALL_OFFLINE=0
